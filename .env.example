APP_NAME="Web Desa Lumeneng"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Lokal: sqlite. Produksi: mysql (isi DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD).
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=lumeneng
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ===== Modul yang tampil di menu =====
MODUL_EWS=true
MODUL_TOKO=true
MODUL_EDUKASI=false

# ===== Akun admin (dibuat oleh AdminSeeder). Di luar lokal, kata sandi lemah ditolak. =====
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===== EWS (peringatan dini longsor) =====
# Kunci rahasia yang dipasang di ESP32 (header X-API-KEY). Teks acak panjang, mis. 32 karakter.
# Kalau kosong, semua kiriman alat ditolak (401).
EWS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Jeda (menit) antar pesan Telegram "perlu validasi" per wilayah
TELEGRAM_COOLDOWN_MENIT=30
# Alat dianggap tidak mengirim data setelah sekian menit tanpa kiriman
EWS_ALAT_OFFLINE_MENIT=15
# Setelah admin memutuskan laporan, laporan baru wilayah yang sama ditahan sekian menit
EWS_VALIDASI_JEDA_MENIT=30

# ===== Toko: Shopee Open Platform (open.shopee.com → Console → App) =====
# Partner ID dan Partner Key RAHASIA: isi hanya di .env, jangan dikirim ke chat atau di-commit.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# true = toko uji (sandbox). Ganti false setelah aplikasi "Go Live" dan memakai Live Partner Key.
SHOPEE_SANDBOX=true
